# Copy to .env. Never commit .env.
# Large downloads and caches (model weights, BIRD, HF and uv caches) live here, outside the repo.
LEXICON_DOWNLOAD_DIR=
HF_HOME=
UV_CACHE_DIR=

LEXICON_MODE=auto              # replay | live | auto
LEXICON_ALLOW_SPEND=0

# Lexicon's Postgres (docker compose up -d postgres): frozen snapshot + LangGraph checkpoints
EVAL_DSN=postgresql://lexicon_ro:lexicon_ro_local@localhost:5433/lexicon_eval
SNAPSHOT_ADMIN_DSN=postgresql://lexicon_admin:lexicon_admin_local@localhost:5433/lexicon_eval
CHECKPOINT_DSN=postgresql://lexicon_admin:lexicon_admin_local@localhost:5433/lexicon_state

# Tally's warehouse (read through lexicon_ro; publishing uses tally_writer)
WAREHOUSE_DSN=postgresql://lexicon_ro:lexicon_ro_local@localhost:5432/tally
TALLY_WRITER_DSN=postgresql://tally_writer:tally_writer_local@localhost:5432/tally
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Model serving (docker compose --profile model up -d)
CINCH_BASE_URL=http://localhost:8182
LEXICON_MODEL=Qwen/Qwen2.5-7B-Instruct-AWQ
GEMINI_API_KEY=
LEXICON_GPU_MEM=0.80
LEXICON_GPU_POWER_CAP_W=160
LEXICON_GPU_TEMP_MAX_C=75
LEXICON_GPU_DUTY=0.6

# Sibling repos, used read-only
ARES_PATH=../Ares
TALLY_PATH=../Tally
